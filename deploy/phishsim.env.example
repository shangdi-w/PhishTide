# Copy this file to a private location (for example /etc/phishsim.env) and
# export it before starting phishsim, or pass the equivalent flags.
# Never commit real credentials.

PHISH_LISTEN=127.0.0.1:8443
PHISH_PUBLIC_URL=https://phish.example.com
PHISH_DATA_DIR=./data
PHISH_ADMIN_USER=admin
PHISH_ADMIN_PASS=change-me-to-a-long-random-password
# PHISH_ADMIN_PASS_HASH=$2a$10$...   # bcrypt hash, takes precedence over the plaintext

# Optional MySQL backend (SQLite is the default).
# Create a least-privilege account; do not use root with an empty password.
# PHISH_DB_DRIVER=mysql
# PHISH_DB_DSN=phish:change-me@tcp(127.0.0.1:3306)/phishsim?charset=utf8mb4&parseTime=true&loc=Local

PHISH_CLONE_DENY_PRIVATE=true
PHISH_RETENTION_DAYS=30
PHISH_MAX_SEND_TARGETS=500

# Optional integrations.
# PHISH_METRICS_TOKEN=change-me
# PHISH_ALERT_WEBHOOK=https://example.com/hook
# PHISH_LLM_BASE_URL=https://api.deepseek.com/v1
# PHISH_LLM_KEY=sk-...
# PHISH_LLM_MODEL=deepseek-chat
