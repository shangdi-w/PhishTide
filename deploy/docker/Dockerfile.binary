# Runtime-only image for a prebuilt static binary.
#
# Use this when you already have phishsim-linux-amd64 (for example from the
# GitHub release) and do not want to compile Go inside Docker:
#
#   cp phishsim-linux-amd64 ./phishsim
#   docker build -f deploy/docker/Dockerfile.binary -t phishtide:0.1.0 .
#
FROM debian:bookworm-slim

# ca-certificates is installed from the default mirror first so that an https
# APT_MIRROR can be verified afterwards.
ARG APT_MIRROR=
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|http://deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      curl tzdata dumb-init \
      chromium fonts-noto-cjk fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*

# The build context must contain the binary named "phishsim".
COPY phishsim /usr/local/bin/phishsim

ENV PHISH_LISTEN=:8443 \
    PHISH_DATA_DIR=/data \
    TZ=Asia/Shanghai

RUN mkdir -p /data
VOLUME ["/data"]
EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -ksf https://127.0.0.1:8443/__admin/login -o /dev/null || exit 1

ENTRYPOINT ["dumb-init", "/usr/local/bin/phishsim"]
